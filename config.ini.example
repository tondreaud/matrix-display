[Matrix]
hardware_mapping = adafruit-hat-pwm
brightness = 50
gpio_slowdown = 2
limit_refresh_rate_hz = 100
shutdown_delay = 30

[Spotify]
; Get these from https://developer.spotify.com/dashboard
client_id = YOUR_CLIENT_ID_HERE
client_secret = YOUR_CLIENT_SECRET_HERE
redirect_uri = http://127.0.0.1:8080/callback
; device_whitelist = ['Marantz AVR', 'Samsung TV']

[SubwayLane1]
; NYC MTA - Stop ID from GTFS data (https://github.com/Andrew-Dickinson/nyct-gtfs)
; East Village: L06 (L), F14 (F,M), 636 (6), R20 (N,R,W)
stop_ids = R20
direction = N
lines = N,Q

[SubwayLane2]
stop_ids = L03
direction = S
lines = L

[Primitive]
; Photos that draw themselves with geometric shapes (fogleman/primitive).
; source: mix (default; rotates Wikimedia Commons Picture of the Day
; photos, Art Institute of Chicago art, and Met Open Access art -- no
; keys needed), met, museum, or wikimedia alone, flickr
; (interestingness; new API keys now require Flickr Pro), or picsum
; (random photos, no key).
; Picsum is used automatically as a fallback if the chosen source fails.
source = mix
flickr_api_key =
; Generation runs in the background at low priority.
workers = 2
resize = 128
; The build-up is the show: seconds between new shapes (higher = slower).
shape_seconds = 0.5
hold_seconds = 25

[Shanshui]
; Endlessly scrolling Chinese landscape (shan-shui-inf by Lingdong
; Huang, MIT; generator vendored in impl/vendor/shanshui/). Landscapes
; are pre-generated in the background; the display pans across them.
; seed: leave blank for a new landscape on every start, or set a word
; to revisit the same landscape.
seed =
; Seconds per pixel of scroll (higher = slower, calmer).
scroll_seconds = 0.35
; Color scheme: rotate (hold each of classic/sunrise/autumn for a
; strip, then blend into the next across the following strip), a
; single scheme name to stay in it, or a comma list to rotate in
; that order starting with the first (e.g. sunrise,autumn,classic).
palette = rotate


